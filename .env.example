# ==============================================================================
# 🔧 CONFIGURACIÓN DE ENTORNO - PLANTILLA DE EJEMPLO (.env.example)
# ==============================================================================
# NOTA: Duplica este archivo como '.env' en tu entorno local y rellena las variables.
#       NUNCA subas el archivo '.env' real al repositorio de Git.

# ------------------------------------------------------------------------------
# 📱 1. APP & NEGOCIO (Configuración general de la plataforma)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Desmulta"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="573000000000"
NEXT_PUBLIC_CONTACT_EMAIL="contacto@tu-dominio.com"

# Operador legal por defecto asignado en el sistema
DEFAULT_OPERATOR_NAME="Nombre Completo del Operador"
# 🛡️ F-09: NUNCA usar '0000000000'. Configura con la cédula real del operador legal.
DEFAULT_OPERATOR_ID=""
# Datos del apoderado legal (F-02: usados en documentos y notificaciones)
OPERATOR_LEGAL_NAME="Nombre Completo del Apoderado Legal"
OPERATOR_LEGAL_ID=""

# ------------------------------------------------------------------------------
# 🔥 2. FIREBASE CLIENT (Acceso público para la app web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyA..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abcdef"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="tu_vapid_key_aqui"

# ------------------------------------------------------------------------------
# 🛡️ 3. FIREBASE ADMIN SDK (Acceso privilegiado del servidor)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="tu-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 🔐 4. SEGURIDAD Y AUTENTICACIÓN (Secretos criptográficos de backend)
# ------------------------------------------------------------------------------
PII_HMAC_SECRET="genera-un-secreto-hex-64-chars-aqui"
# 🛡️ F-12: PII_ENCRYPTION_KEY DEBE ser diferente a PII_HMAC_SECRET (separación de claves AES vs HMAC).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=""
VIP_JWT_SECRET="genera-un-secreto-jwt-vip-aqui"
CLIENT_PORTAL_JWT_SECRET="genera-un-secreto-jwt-portal-cliente-aqui"
COOKIE_SIGNATURE_SECRET="genera-una-clave-cookie-base64-aqui"
AUTH_COOKIE_SIGNATURE_KEY_CURRENT="genera-clave-aes-base64-aqui"
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS="genera-clave-aes-base64-aqui"
INTERNAL_API_SECRET="genera-secreto-api-interna-aqui"
CRON_SECRET="genera-cron-secret-aqui"
# 🛡️ F-04: Secreto para autenticar reportes de errores críticos del sistema.
# Genera con: openssl rand -hex 32
CRASH_REPORT_SECRET=""
# 🛡️ F-05: Control de acceso de admins. Si está vacío, cualquier token Firebase admin puede administrar.
ADMIN_EMAILS="admin@tu-dominio.com"

# ------------------------------------------------------------------------------
# 🗝️ 5. CRIPTOGRAFÍA ASIMÉTRICA (Túnel E2EE - RSA-OAEP)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RSA_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 🌐 6. SERVICIOS EXTERNOS E INTEGRACIONES
# ------------------------------------------------------------------------------
# 6.1 Cloudflare Turnstile (Captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="tu_turnstile_site_key"
TURNSTILE_SECRET_KEY="tu_turnstile_secret_key"

# 6.2 Email (Resend)
RESEND_API_KEY="re_xxxxxxxxx"

# 6.3 Sentry (Monitoreo de Errores)
NEXT_PUBLIC_SENTRY_DSN=""

# 6.4 Notificaciones y Bot de Telegram
TELEGRAM_BOT_TOKEN="tu_telegram_bot_token"
TELEGRAM_CHAT_ID="tu_telegram_chat_id"
# Chat ID del grupo de desarrollo (puede ser el mismo que TELEGRAM_CHAT_ID o uno dedicado)
TELEGRAM_DEV_CHAT_ID="tu_telegram_dev_chat_id"
# Chat separado para alertas críticas de seguridad (exportaciones masivas de DB por operadores)
# Si no se configura, logExportAction() fallará silenciosamente sin enviar la alerta de seguridad.
TELEGRAM_SECURITY_CHAT_ID="tu_telegram_security_chat_id"
TELEGRAM_WEBHOOK_SECRET="genera-secreto-webhook-aqui"

# 6.5 Blog Automático (RSS/Atom-to-MDX)
BLOG_RSS_URL="https://www.google.com/alerts/feeds/xxxxxxxx,https://www.google.com/alerts/feeds/yyyyyyyy"
# Habilitar publicación automática (true = publica de inmediato, false = crea borradores)
AUTO_PUBLISH_BLOG="false"
# Límite máximo de noticias auto-importadas a mantener para evitar basura (limpieza automática)
MAX_BLOG_POSTS="30"

# 6.6 Inteligencia Artificial (Gemini & OCR)
GEMINI_API_KEY="tu_gemini_api_key"
NEXT_PUBLIC_TESSDATA_URL="https://xxxxxx.public.blob.vercel-storage.com"

# 6.7 Almacenamiento Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxx"

# 6.8 Pagos — Wompi Colombia (F-01: requeridas para validar webhooks de pago)
# Obtener desde: https://dashboard.wompi.co -> Desarrolladores -> Llaves
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# ------------------------------------------------------------------------------
# 🛠️ 7. DEBUGGING Y HERRAMIENTAS DE DESARROLLO
# ------------------------------------------------------------------------------
# 🛡️ F-11: PINs deben configurarse explícitamente. Valores vacíos obligan al desarrollador a definirlos.
# OPERATOR_PIN protege exportación de PDFs de admin. Usa una contraseña fuerte, NO un PIN de 4 dígitos.
# Genera con: openssl rand -base64 16 | tr -dc 'a-zA-Z0-9' | head -c 16
NEXT_PUBLIC_DEBUG_PIN=""
OPERATOR_PIN=""
SUPERADMIN_AUDIT_PASSWORD="tu-contrasena-aqui"
GOD_MODE_JWT_SECRET="genera-god-mode-jwt-secret"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
LOCAL_CHROMIUM_PATH="C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"

# ------------------------------------------------------------------------------
# ☁️ 8. GENERACIÓN DE PDF (Firebase Cloud Functions)
# ------------------------------------------------------------------------------
PDF_API_SECRET="tu-secreto-pdf-comunicacion"
PDF_CLOUD_FUNCTION_URL="https://generatepdf-xxxxxx.a.run.app"

# ------------------------------------------------------------------------------
# 🏎️ 9. UPSTASH REDIS (Rate Limiting y Caché Serverless)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_upstash_aqui"

# 🛡️ N-02 DEVSECOPS: Variables de QStash para la cola de OCR asíncrono B2B.
# Sin estas variables el worker /api/qstash/ocr-worker responde 503 (fail-closed).
# Obtener desde: https://console.upstash.com → QStash → Keys
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Webhook de Sentry para Telegram
SENTRY_WEBHOOK_SECRET=una_clave_secreta_aleatoria

# ------------------------------------------------------------------------------
# 📈 10. SEO Y ANALÍTICAS BÁSICAS
# ------------------------------------------------------------------------------
# Código provisto por Google Search Console al validar tu dominio.
# Ejemplo: 'vB9-XyZ123ABC...'
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
