# ─── SERVICIOS CORE ───────────────────────────────────────
# GEMINI_API_KEY: Llave para el motor OCR Multimodal (Gemini 1.5 Flash)
GEMINI_API_KEY=tu_gemini_api_key_aqui
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SITE_URL=http://localhost:9005
NEXT_PUBLIC_BRAND_NAME=Desmulta

# ─── VERCEL BLOB (Almacenamiento de Imágenes) ──────────────
# ⚠️ CRÍTICO: Sin esta variable /api/gallery y /api/upload fallan con error 500
# Obtener desde: Vercel Dashboard > Storage > Blob > Connect Store > .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ─── CLOUDFLARE TURNSTILE (Seguridad Anti-Bot) ─────────────
# Público: Para renderizar el widget en el cliente
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_site_key_aqui
# Privado: Solo para validación en el servidor (create-consultation)
TURNSTILE_SECRET_KEY=tu_secret_key_aqui

# ─── FIREBASE CONFIG (Requerido para validación Edge REST) ─
# Firebase Admin (Producción)
# NOTA PARA VERCEL: Pegar la llave tal cual viene en el JSON de Firebase (incluyendo BEGIN/END y \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD... (ejemplo)\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@xxxxx.iam.gserviceaccount.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_project_id
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key
NEXT_PUBLIC_BASE_API_KEY=tu_base_api_key # API Key base si aplica
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─── SEGURIDAD INTERNA ────────────────────────────────────
# Generar con: node -e "require('crypto').randomBytes(32).toString('hex')|Write-Host"
# CRON_SECRET: Protege el endpoint /api/internal/followup-cron — solo Vercel Cron puede llamarlo
CRON_SECRET=genera-secreto-hex-64-chars-aqui
INTERNAL_API_SECRET=genera-secreto-aqui
# Clave exclusiva para firmar cookies — mínimo 32 chars
# Generar con: openssl rand -base64 32
COOKIE_SIGNATURE_SECRET=genera-una-clave-aleatoria-aqui

# Zero-PII HMAC Secret - Para hashear cédulas y teléfonos (Obligatorio)
PII_HMAC_SECRET=genera-secreto-hmac-aqui

# God Mode Admin Panel (Obligatorios, sin valores por defecto)
SUPERADMIN_AUDIT_PASSWORD=tu-contrasena-super-segura-aqui
GOD_MODE_JWT_SECRET=genera-jwt-secret-aqui

# ─── TELEGRAM BOT ─────────────────────────────────────────
# De @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui
# ID del grupo/canal del operador (ej: -100123456789)
TELEGRAM_CHAT_ID=tu_chat_id_aqui
# ID del grupo/canal de seguridad y auditoría
TELEGRAM_SECURITY_CHAT_ID=tu_security_chat_id_aqui
# Generar con: openssl rand -hex 20
TELEGRAM_WEBHOOK_SECRET=genera-secreto-aqui

# ─── EMAIL (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── ANALÍTICA Y MARKETING ────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXX
NEXT_PUBLIC_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=573005648309

# ─── OPERADOR LEGAL (Para generación del Poder Especial) ──────────────
DEFAULT_OPERATOR_NAME=Nombre Completo del Operador
DEFAULT_OPERATOR_ID=0000000000

# ─── CIFRADO E2EE (RSA-OAEP) ─────────────────────────
# Generar par de llaves con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Copiar el contenido de public.pem (con cabeceras) aquí:
NEXT_PUBLIC_RSA_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Solo para servidor (NUNCA en NEXT_PUBLIC_):
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_VAPID_KEY= 

# PIN de 4 dígitos para activar el debugger en producción
# (En producción se configura en el Vercel Dashboard)
NEXT_PUBLIC_DEBUG_PIN=1234 # CAMBIAR EN PRODUCCIÓN

LOCAL_CHROMIUM_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# ─── BLOG AUTOMÁTICO DE NOTICIAS ──────────────────────────
# URLs de feeds RSS/Atom (Google Alerts) separadas por comas
BLOG_RSS_URL=https://www.google.com/alerts/feeds/xxxxxxxx/xxxxxxx
# Habilitar publicación automática (true = publica de inmediato, false = crea borradores)
AUTO_PUBLISH_BLOG=false

# ─── UPSTASH REDIS (Rate Limiting y Caché Serverless) ─────
UPSTASH_REDIS_REST_URL=https://xxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash_aqui

# ─── GENERACIÓN DE PDF (Firebase Cloud Functions) ────────
PDF_API_SECRET=tu_secreto_pdf_aqui
PDF_CLOUD_FUNCTION_URL=https://generatepdf-xxxxxx.a.run.app

